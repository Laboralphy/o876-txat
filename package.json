{
    "name": "@laboralphy/o876-txat",
    "version": "2.0.0",
    "description": "An embeddable chat library: multi channels, moderation, event based",
    "author": "Raphaël Marandet",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Laboralphy/o876-txat.git"
    },
    "homepage": "https://github.com/Laboralphy/o876-txat#readme",
    "bugs": {
        "url": "https://github.com/Laboralphy/o876-txat/issues"
    },
    "keywords": [
        "chat",
        "library",
        "channels",
        "mud",
        "events"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:exports": "attw --pack . && publint",
        "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@types/node": "^24.19.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.4",
        "publint": "^0.3.12",
        "tsup": "^8.5.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0",
        "vitest": "^5.0.2"
    }
}
