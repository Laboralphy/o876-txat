{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "vitest/globals"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src", "__tests__"]
}
